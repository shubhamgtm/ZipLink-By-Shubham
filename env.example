# Port and interface the server listens on. Use HOST=0.0.0.0 to reach it from other devices or inside a container.
PORT=3000
HOST=127.0.0.1

# Public address of your ZipLink, with no trailing slash. Leave empty to use the address the request came in on.
BASE_URL=

# Admin login. Create the hash with: npm run hash -- "your password"
# Keep the single quotes around the hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# At least 32 characters. Create one with: npm run secret
SESSION_SECRET=

# How long an admin session lasts, in hours.
SESSION_HOURS=12

# Set to 1 when running behind one reverse proxy such as nginx, Caddy or a hosting platform.
TRUST_PROXY=
